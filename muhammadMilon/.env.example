# =========================
# App Config
# =========================

AUTH_URL=https://nexora-studio-ten.vercel.app
NEXTAUTH_URL=https://nexora-studio-ten.vercel.app
AUTH_SECRET=your_auth_secret_here
# No space after = in AUTH_SECRET

NEXT_PUBLIC_APP_URL=http://localhost:3000

# =========================
# Database
# =========================

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# =========================
# Google OAuth (Auth.js)
# =========================

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# =========================
# Gemini AI
# =========================

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# =========================
# Stripe Payment
# =========================

STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# =========================
# Email (Nodemailer / Gmail SMTP)
# =========================

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM="Nexora Studio <your_email@gmail.com>"

# =========================
# Cloudinary
# =========================

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_here

# =========================
# Optional Services
# =========================

# RESEND_API_KEY=your_resend_api_key_here
# EMAIL_FROM="Nexora Studio <onboarding@resend.dev>"